# Copie este arquivo para .env e preencha os valores
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE
FLASK_DEBUG=1
FLASK_COOKIE_SECURE=0

# MongoDB Atlas (ou MongoDB local: mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=innova_eletromoveis

# Supabase: Project Settings > API Keys (chaves mantidas SOMENTE no servidor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLISHABLE_OU_ANON
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SECRET_OU_SERVICE_ROLE

# Redis Cloud (ou redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Número indicado na logomarca: +55 (89) 98134-2222
WHATSAPP_NUMBER=5589981342222
WHATSAPP_DISPLAY=(89) 98134-2222
